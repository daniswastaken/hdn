---
interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'HDN // Handaru Delivery Network',
  description = 'Edge Asset Registry & Git-backed CDN for images, fonts, icons, SVGs, and Git LFS artifacts.',
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <link rel="icon" type="image/svg+xml" href="./favicon.svg" />
    <script is:inline>
      (() => {
        try {
          const saved = localStorage.getItem('hdn-theme');
          if (saved === 'light') {
            document.documentElement.classList.add('theme-light');
          }
        } catch {}
      })();
    </script>
  </head>
  <body class="min-h-screen antialiased selection:bg-[var(--hdn-accent)] selection:text-[var(--hdn-accent-ink)]">
    <slot />
  </body>
</html>
